{
  "name": "context-passport",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, privacy-first AI context handoff bundles.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
