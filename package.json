    "format": "prettier --write .",
    "passport": "pnpm --filter @context-passport/cli passport"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "pnpm": "latest"
  }
}
