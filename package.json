{
  "name": "context-passport",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first, privacy-first AI context handoff bundles.",
  "license": "MIT",
  "keywords": [
    "ai",
    "context",
    "privacy",
    "redaction",
    "browser-extension",
    "cli",
    "local-first",
    "handoff"
  ],
  "homepage": "https://github.com/itolkien/context-passport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itolkien/context-passport.git"
  },
  "bugs": {
    "url": "https://github.com/itolkien/context-passport/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @context-passport/core build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "passport": "pnpm --filter @context-passport/cli passport"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "dependencies": {
    "pnpm": "^11.1.0"
  },
  "author": ""
}
